#!/bin/sh
# Copy the device's own firmware out of the stock Android vendor partition
# (vendor_b inside super) into /lib/firmware. Lenovo's files are not part of
# the image. Runs at every boot before udev loads the drivers; it does
# nothing once the files are there.
fw=/lib/firmware
soc=$fw/qcom/sm6115/LENOVO/J606L
[ -e $fw/novatek_ts_fw.bin ] && [ -e $soc/modem.mdt ] && [ -e $soc/a610_zap.mdt ] && [ -e $fw/awinic/aw882xx_acf.bin ] && \
	[ -e /usr/share/qcom/sm6115/Lenovo/J606L/sensors/sns_reg.conf ] && exit 0
super=
for u in /sys/class/block/*/uevent; do
	grep -qx PARTNAME=super "$u" && super=/dev/$(sed -n 's/^DEVNAME=//p' "$u")
done
[ -b "$super" ] || exit 1
img=/run/haltia-vendor.img
mnt=/run/haltia-vendor
LP_SLOT=1 python3 /usr/sbin/haltia-lpdump "$super" vendor_b "$img" || exit 1
mkdir -p $mnt $fw
mount -o ro,loop "$img" $mnt || exit 1
cp $mnt/firmware/novatek_ts_fw.bin $fw/
# Adreno 610: the stock zap shader and the a630 SQE microcode.
mkdir -p $soc $fw/qcom
cp $mnt/firmware/a610_zap.* $soc/
cp $mnt/firmware/a630_sqe.fw $fw/qcom/
# Register profiles of the four AW88258 speaker amplifiers.
mkdir -p $fw/awinic
cp $mnt/firmware/awinic/aw882xx_acf.bin $fw/awinic/
umount $mnt
rm -f "$img"

# The modem (it runs the WLAN firmware) and the DSPs, from modem_b.
mkdir -p $soc $fw/ath10k/WCN3990/hw1.0
for u in /sys/class/block/*/uevent; do
	grep -qx PARTNAME=modem_b "$u" && mount -o ro "/dev/$(sed -n 's/^DEVNAME=//p' "$u")" $mnt
done
# The whole image directory: the modem also needs modem_pr (its MCFG
# configuration); without it its watchdog fires 40 s into the first start.
cp -a $mnt/image/. $soc/
# Board data for board id 0xff; linux-firmware has no Lenovo_P11 entry.
cp $mnt/image/bdwlan.bin $fw/ath10k/WCN3990/hw1.0/board.bin
umount $mnt
# ADSP sensors (hexagonrpcd): the DSP libraries from dsp_b, the sensor
# configs from vendor_b and the sensor registry from persist. persist is
# mounted read-only without journal replay: it is never written.
q=/usr/share/qcom/sm6115/Lenovo/J606L
if [ ! -e $q/sensors/sns_reg.conf ]; then
	mkdir -p $q/dsp $q/sensors/config $q/socinfo
	part() {
		for u in /sys/class/block/*/uevent; do
			grep -qx "PARTNAME=$1" "$u" && echo "/dev/$(sed -n 's/^DEVNAME=//p' "$u")"
		done
	}
	mount -o ro "$(part dsp_b)" $mnt && cp -a $mnt/. $q/dsp/ && umount $mnt
	LP_SLOT=1 python3 /usr/sbin/haltia-lpdump "$super" vendor_b "$img" &&
		mount -o ro,loop "$img" $mnt && {
			cp $mnt/etc/sensors/config/*.json $q/sensors/config/
			cp $mnt/etc/sensors/sns_reg_config $q/sensors/sns_reg.conf
			umount $mnt
		}
	rm -f "$img"
	mount -t ext4 -o ro,noload "$(part persist)" $mnt && {
		cp -a $mnt/sensors/registry $q/sensors/
		umount $mnt
	}
	# The registry picks its configs by the board, as Android's
	# /sys/devices/soc0 tells it: an IDP board (34), SoC 444.
	echo IDP > $q/socinfo/hw_platform
	echo Unknown > $q/socinfo/platform_subtype
	echo 0 > $q/socinfo/platform_subtype_id
	echo 65536 > $q/socinfo/platform_version
	echo 444 > $q/socinfo/soc_id
	echo 1.0 > $q/socinfo/revision
	chown -R fastrpc:fastrpc $q
fi
# linux-firmware ships firmware-5.bin compressed; give the kernel a plain one.
z=$fw/ath10k/WCN3990/hw1.0/firmware-5.bin.zst
[ -e "$z" ] && zstd -qdf "$z" -o "${z%.zst}"
