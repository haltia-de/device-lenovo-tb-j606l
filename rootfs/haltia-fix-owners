#!/usr/bin/env python3
"""Give installed files the owners their packages name.

The root is unpacked on an x86 host with apk --no-scripts, before the
packages' own users and groups exist, so files owned by messagebus,
polkitd and the like come out as root. After the first boot has created
those accounts, read the owner names back from the packages in the apk
cache and set them."""
import glob
import grp
import os
import pwd
import tarfile

fixed = 0
for path in glob.glob('/etc/apk/cache/*.apk'):
    try:
        archive = tarfile.open(path, 'r:gz')
        members = archive.getmembers()
    except (tarfile.TarError, OSError, EOFError):
        continue
    for m in members:
        if m.name.startswith('.') or (m.uname in ('', 'root') and m.gname in ('', 'root')):
            continue
        target = '/' + m.name
        try:
            uid = pwd.getpwnam(m.uname).pw_uid if m.uname else 0
            gid = grp.getgrnam(m.gname).gr_gid if m.gname else 0
            os.lchown(target, uid, gid)
            if not m.issym():
                os.chmod(target, m.mode)  # chown drops setuid bits
            fixed += 1
        except (KeyError, OSError):
            pass
print('haltia-fix-owners: %d files' % fixed)
