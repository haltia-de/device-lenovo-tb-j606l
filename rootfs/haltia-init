#!/bin/sh
# PID 1 before OpenRC on the TB-J606L: a USB serial root shell for
# development, the one-time first boot setup, then /sbin/init.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t configfs configfs /sys/kernel/config 2>/dev/null
mount -o remount,rw /

# USB: ACM shell (ttyGS0 on the tablet, ttyACM0 on the host) and NCM
# network (tablet 10.15.0.2, host 10.15.0.1).
g=/sys/kernel/config/usb_gadget/haltia
if [ -d /sys/kernel/config/usb_gadget ] && [ ! -d $g ]; then
	mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409 $g/functions/acm.usb0 $g/functions/ncm.usb0
	echo 0x1d6b > $g/idVendor
	echo 0x0104 > $g/idProduct
	echo "Haltia" > $g/strings/0x409/manufacturer
	echo "Lenovo Tab P11 TB-J606L" > $g/strings/0x409/product
	echo "Haltia" > $g/configs/c.1/strings/0x409/configuration
	# Fixed addresses, so the host keeps one interface name across boots.
	echo 02:4a:36:06:00:02 > $g/functions/ncm.usb0/dev_addr
	echo 02:4a:36:06:00:01 > $g/functions/ncm.usb0/host_addr
	ln -s $g/functions/acm.usb0 $g/configs/c.1/
	ln -s $g/functions/ncm.usb0 $g/configs/c.1/
	for i in $(seq 1 50); do udc=$(ls /sys/class/udc 2>/dev/null | head -1); [ -n "$udc" ] && break; sleep 0.1; done
	echo "$udc" > $g/UDC
	ip link set usb0 up 2>/dev/null
	ip addr add 10.15.0.2/24 dev usb0 2>/dev/null
	ip route add default via 10.15.0.1 2>/dev/null
fi
# Development images only (build-rootfs.sh with DEBUG=1). The shell is
# root without a password.
if [ -e /etc/haltia/debug-shell ]; then
	setsid sh -c 'while :; do [ -c /dev/ttyGS0 ] && sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1; sleep 1; done' &
fi

# Firmware from the stock vendor partition, before udev loads drivers.
/usr/sbin/haltia-firmware

# Boot into Android next time unless this boot reaches the desktop
# (desktop.start arms Linux again).
/usr/sbin/haltia-boot android

[ -e /var/lib/haltia/firstboot-done ] || /sbin/haltia-firstboot
exec /sbin/init
