#!/bin/sh
# TB-J606L system sleep, run by haltia-sleep as /usr/lib/haltia/hooks/suspend.
#
# The sensor proxy stops first: while the accelerometer streams, the ADSP
# wakes the system every second or two. The system then sleeps in s2idle
# and goes back to sleep after any wake the DSPs alone caused (a fastrpc
# message holds it up half a second, the sensor framework rings
# smp2p-sleepstate) or a sleep the kernel turned down while such an event
# was still active. Any other wake source (the power key, the touch
# screen's double tap, the charger, the RTC) ends the sleep, and the hook
# returns with the proxy started again and giving readings.
DSP=" adsp cdsp smp2p-sleepstate "
# Sleeps in one call. Each wake costs about a second awake; haltia-sleep
# kills a hook awake for 120 s, and calls it again 30 s after it returns.
MAX=60

events() {
	awk 'NR > 1 { print $1, $3 }' /sys/kernel/debug/wakeup_sources
}

# The sources whose event count grew from $1 to $2 that are not the DSPs'.
woken_by() {
	printf '%s\n' "$2" | awk -v dsp="$DSP" -v before="$1" '
		BEGIN {
			n = split(before, line, "\n")
			for (i = 1; i <= n; i++) {
				split(line[i], f, " ")
				seen[f[1]] = f[2]
			}
		}
		$2 != seen[$1] && index(dsp, " " $1 " ") == 0 { print $1 }
	'
}

mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug
rc-service iio-sensor-proxy stop >/dev/null 2>&1

n=0
while [ "$n" -lt "$MAX" ]; do
	n=$((n + 1))
	before=$(events)
	sync
	echo freeze > /sys/power/state 2>/dev/null
	who=$(woken_by "$before" "$(events)")
	if [ -n "$who" ]; then
		echo "haltia-suspend: woke by $(echo $who) after $n sleeps"
		break
	fi
	sleep 1
done

# Started at once after the wake, the proxy found the accelerometer but
# got no readings ("orientation: undefined"); a few seconds later it does.
sleep 3
for try in 1 2 3; do
	rc-service iio-sensor-proxy restart >/dev/null 2>&1
	sleep 4
	(timeout 4 monitor-sensor 2>/dev/null) 2>/dev/null |
		grep -q "orientation: undefined" || break
	echo "haltia-suspend: no accelerometer readings, starting the proxy again"
done
exit 0
