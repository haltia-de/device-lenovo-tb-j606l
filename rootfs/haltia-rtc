#!/bin/sh
# The TB-J606L's PMIC RTC keeps counting while the tablet is off but cannot
# be set: it runs from 1970. As Android's time daemon does, keep the offset
# between the real time and the RTC and add it at boot.
#
#   haltia-rtc restore   set the system clock to RTC + offset (boot)
#   haltia-rtc save      store the offset, if the clock looks right
#   haltia-rtc <event>   the same as save; busybox ntpd -S runs it after it
#                        steps the clock and every 11 minutes
RTC=/sys/class/rtc/rtc0/since_epoch
DIR=/var/lib/haltia/rtc
OFFSET=$DIR/offset
SANE=1793000000 # 2026-10-26: a clock before this was never set

rtc() {
	cat "$RTC" 2>/dev/null
}

case "$1" in
restore)
	r=$(rtc) || exit 0
	off=$(cat "$OFFSET" 2>/dev/null) || exit 0
	[ -n "$r" ] && [ -n "$off" ] || exit 0
	date -s "@$((r + off))" >/dev/null
	;;
*)
	r=$(rtc) || exit 0
	now=$(date +%s)
	[ -n "$r" ] && [ "$now" -ge "$SANE" ] || exit 0
	echo $((now - r)) > "$OFFSET.new" && mv "$OFFSET.new" "$OFFSET"
	;;
esac
exit 0
