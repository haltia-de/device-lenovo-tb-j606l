// SPDX-License-Identifier: BSD-3-Clause
/* Lenovo Tab P11 TB-J606L (LTE). Derived from the upstream J606F tree. */
#include <dt-bindings/input/gpio-keys.h>
#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include <dt-bindings/usb/pd.h>
#include "sm6115p-lenovo-j606f.dts"

/ {
	model = "Lenovo Tab P11 TB-J606L";
	compatible = "lenovo,j606l", "qcom,sm6115p", "qcom,sm6115";
	/* Measured on the lab unit: SoC 444, platform 0x10000; board 34/3. */
	qcom,msm-id = <444 0x10000>;
	qcom,board-id = <34 3>;

	aliases {
		serial1 = &uart3;
	};

	/* Four AW88258 speaker amplifiers on the LPASS primary MI2S port
	 * (data line 1); the ES7210 microphone ADC on the secondary one. */
	sound {
		compatible = "qcom,qrb4210-rb2-sndcard";
		model = "Lenovo-TB-J606L";
		pinctrl-0 = <&lpi_i2s1_active>, <&lpi_i2s2_active>;
		pinctrl-names = "default";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
			};
		};

		speaker-dai-link {
			link-name = "Speaker Playback";

			cpu {
				sound-dai = <&q6afedai PRIMARY_MI2S_RX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&speaker0>, <&speaker1>, <&speaker2>, <&speaker3>;
			};
		};

		mic-dai-link {
			link-name = "Mic Capture";

			cpu {
				sound-dai = <&q6afedai SECONDARY_MI2S_TX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&microphones>;
			};
		};
	};

	/* Hall sensor for the folio cover, as the stock hall_switch. */
	gpio-keys-lid {
		compatible = "gpio-keys";
		pinctrl-0 = <&hall_int_default>;
		pinctrl-names = "default";

		switch-lid {
			label = "Cover";
			gpios = <&tlmm 36 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			debounce-interval = <15>;
			wakeup-source;
			/* Wake when the cover opens, not on the closing edge. */
			wakeup-event-action = <EV_ACT_DEASSERTED>;
		};
	};
};

/* Only the HS PHY is wired. Without UTMI as the pipe clock the core comes
 * up only after a fastboot session left it clocked (26 October 2026). */
&usb { qcom,select-utmi-as-pipe-clk; };

/* The modem runs the WLAN firmware. haltia-firmware copies the stock split
 * images from modem_b; rmtfs serves copies of the EFS partitions read-only. */
&remoteproc_mpss {
	firmware-name = "qcom/sm6115/LENOVO/J606L/modem.mdt";
	status = "okay";
};

/* Display through MSM DRM and the upstream J606F panel driver (the J606L
 * has the same BOE NT36523W, as its stock command line names). simplefb
 * shows the bootloader picture until msm takes over. The GPU loads the
 * stock zap shader that haltia-firmware copies from vendor_b. */
&gpu_zap_shader {
	firmware-name = "qcom/sm6115/LENOVO/J606L/a610_zap.mdt";
};

/* ADSP runs the audio services (APR: q6afe, q6asm) and the sensors; CDSP
 * is the compute DSP. Both boot the stock split images from modem_b. */
&remoteproc_adsp {
	firmware-name = "qcom/sm6115/LENOVO/J606L/adsp.mdt";
	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm6115/LENOVO/J606L/cdsp.mdt";
	status = "okay";
};

/* Touch: Novatek NT36523 (TDDI, no flash) on QUP SE2 SPI, chip select 1,
 * as in the stock overlay. The driver loads novatek_ts_fw.bin from the
 * stock vendor partition at every start. */
&qupv3_id_0 { status = "okay"; };

&spi2 {
	/* GPI DMA transfers stalled the touch thread in spi_transfer_one_message;
	 * without dmas the GENI controller uses FIFO and SE DMA. */
	/delete-property/ dmas;
	/delete-property/ dma-names;
	status = "okay";

	touchscreen@0 {
		compatible = "novatek,NVT-ts-spi";
		reg = <0>;
		/* The NT36523W is touch and display in one: turning the panel off
		 * resets the touch side, so the driver follows the panel and loads
		 * the touch firmware again whenever it comes back on. */
		panel = <&panel>;
		spi-max-frequency = <9600000>;
		interrupts-extended = <&tlmm 86 IRQ_TYPE_EDGE_RISING>;
		reset-gpios = <&tlmm 54 GPIO_ACTIVE_HIGH>;
		irq-gpios = <&tlmm 86 GPIO_ACTIVE_HIGH>;
		firmware-name = "novatek_ts_fw.bin";
		pinctrl-0 = <&ts_int_default>;
		pinctrl-names = "default";
		novatek,swrst-n8-addr = <0x3f0fe>;
		novatek,spi-rd-fast-addr = <0x3f310>;
		novatek,event-buf-addr = <0x2fe00>;
		novatek,coords-12bit;
		/* A double tap wakes the tablet from sleep (gesture mode). */
		novatek,double-tap-wake;
		touchscreen-size-x = <1200>;
		touchscreen-size-y = <2000>;
	};
};

&tlmm {
	/* The stock "pmx_ts_int_active": the interrupt line needs a pull-up. */
	ts_int_default: ts-int-default-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
};

/* Battery gauge on QUP SE0 I2C, as in the stock overlay. GENI I2C needs
 * its GPI DMA channels to probe. */
&gpi_dma0 { status = "okay"; };

&i2c0 {
	clock-frequency = <400000>;
	status = "okay";

	/* The amplifiers share reset GPIO 42; awinic,channel picks each one's
	 * section of the stock ACF profile (left/right on SD0, then SD1). */
	speaker0: audio-codec@34 {
		compatible = "awinic,aw88258";
		reg = <0x34>;
		reset-gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
		awinic,channel = <0>;
		sound-name-prefix = "Speaker 0";
		#sound-dai-cells = <0>;
	};

	speaker1: audio-codec@35 {
		compatible = "awinic,aw88258";
		reg = <0x35>;
		reset-gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
		awinic,channel = <1>;
		sound-name-prefix = "Speaker 1";
		#sound-dai-cells = <0>;
	};

	speaker2: audio-codec@36 {
		compatible = "awinic,aw88258";
		reg = <0x36>;
		reset-gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
		awinic,channel = <2>;
		sound-name-prefix = "Speaker 2";
		#sound-dai-cells = <0>;
	};

	speaker3: audio-codec@37 {
		compatible = "awinic,aw88258";
		reg = <0x37>;
		reset-gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
		awinic,channel = <3>;
		sound-name-prefix = "Speaker 3";
		#sound-dai-cells = <0>;
	};

	/* USB-C port controller, as the stock fusb302@22. A sink only for now:
	 * its power supply tells the shell when a charger is plugged in. */
	typec@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		interrupts-extended = <&tlmm 97 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&fusb302_int_default>;
		pinctrl-names = "default";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "sink";
			data-role = "device";
			self-powered;
			sink-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM)>;
			op-sink-microwatt = <10000000>;
		};
	};

	fuel-gauge@55 {
		compatible = "mitsumi,mm8013";
		reg = <0x55>;
	};
};

/* Backlight: SGM37604A on QUP SE1 I2C; PMI632 GPIO 6 enables it (the
 * bootloader leaves it on). */
&i2c1 {
	clock-frequency = <400000>;
	status = "okay";

	/* The microphones' ADC; vcc is L24, shared with the UFS. */
	microphones: audio-codec@40 {
		compatible = "everest,es7210";
		reg = <0x40>;
		vcc-supply = <&pm6125_l24>;
		#sound-dai-cells = <0>;
	};

	backlight@36 {
		compatible = "sgmicro,sgm37604a";
		reg = <0x36>;
	};
};

/* Bluetooth: the WCN3990 on QUP SE3 high-speed UART, supplies as in the
 * stock bt_wcn3990 node. Firmware comes from linux-firmware-qca. */
&uart3 {
	interrupts-extended = <&intc GIC_SPI 330 IRQ_TYPE_LEVEL_HIGH>,
			      <&tlmm 11 IRQ_TYPE_EDGE_FALLING>;
	pinctrl-0 = <&uart3_default>;
	pinctrl-1 = <&uart3_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn3990-bt";
		vddio-supply = <&pm6125_l9>;
		vddxo-supply = <&pm6125_l16>;
		vddrf-supply = <&pm6125_l17>;
		vddch0-supply = <&pm6125_l23>;
		max-speed = <3200000>;
	};
};

&tlmm {
	fusb302_int_default: fusb302-int-default-state {
		pins = "gpio97";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	hall_int_default: hall-int-default-state {
		pins = "gpio36";
		function = "gpio";
		drive-strength = <6>;
		bias-pull-up;
	};

	uart3_default: uart3-default-state {
		cts-pins {
			pins = "gpio8";
			function = "qup3";
			drive-strength = <2>;
			bias-bus-hold;
		};

		rts-pins {
			pins = "gpio9";
			function = "qup3";
			drive-strength = <2>;
			bias-disable;
		};

		tx-pins {
			pins = "gpio10";
			function = "qup3";
			drive-strength = <2>;
			bias-disable;
		};

		rx-pins {
			pins = "gpio11";
			function = "qup3";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	uart3_sleep: uart3-sleep-state {
		cts-pins {
			pins = "gpio8";
			function = "gpio";
			drive-strength = <2>;
			bias-bus-hold;
		};

		rts-pins {
			pins = "gpio9";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-down;
		};

		tx-pins {
			pins = "gpio10";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};

		rx-pins {
			pins = "gpio11";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

&q6afedai {
	dai@16 {
		reg = <PRIMARY_MI2S_RX>;
		qcom,sd-lines = <1>;
	};

	dai@19 {
		reg = <SECONDARY_MI2S_TX>;
		qcom,sd-lines = <0>;
	};
};

&lpass_tlmm {
	lpi_i2s2_active: lpi-i2s2-active-state {
		sck-pins {
			pins = "gpio10";
			function = "i2s2_clk";
			drive-strength = <8>;
			bias-disable;
		};

		ws-pins {
			pins = "gpio11";
			function = "i2s2_ws";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio12", "gpio13";
			function = "i2s2_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	lpi_i2s1_active: lpi-i2s1-active-state {
		sck-pins {
			pins = "gpio6";
			function = "i2s1_clk";
			drive-strength = <8>;
			bias-disable;
			output-high;
		};

		ws-pins {
			pins = "gpio7";
			function = "i2s1_ws";
			drive-strength = <8>;
			bias-disable;
			output-high;
		};

		data-pins {
			pins = "gpio8", "gpio9";
			function = "i2s1_data";
			drive-strength = <8>;
			bias-disable;
			output-high;
		};
	};
};

/* The touch half of the TDDI chip needs it powered and out of reset while
 * the display sleeps, to see the double tap that wakes the tablet. */
&panel {
	novatek,tddi-touch-wake;
};
